# CogniFlow 开发模式 Dockerfile
# 特点：挂载源码、热重载
# 用法: docker compose --profile dev up

FROM python:3.10-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    ffmpeg \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（CPU 版）
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
        fastapi uvicorn[standard] pydantic python-multipart \
        sqlalchemy aiosqlite \
        ultralytics numpy opencv-python pillow pyyaml psutil \
        mss pyautogui ffmpeg-python pygetwindow \
        gymnasium tensorboard \
        pytest pytest-asyncio httpx

# 安装 pnpm
RUN npm install -g pnpm

# 复制项目源码
COPY . .

# 安装前端依赖（让 vite 监听文件变化）
WORKDIR /app/webui
RUN pnpm install

# 回到项目根目录
WORKDIR /app

EXPOSE 8000 5173

# 启动命令：后端热重载 + 前端开发服务器
# 后端用 uvicorn --reload，前端用 vite
CMD ["sh", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port 8000 --reload & \
     cd webui && pnpm dev --host 0.0.0.0 --port 5173 & \
     wait"]
